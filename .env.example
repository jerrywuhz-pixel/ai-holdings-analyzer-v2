# ============================================================
# AI Holdings Analyzer v2 — 部署环境变量模板
# ============================================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# === 部署模式 ===
DEPLOYMENT_MODE=cloud              # local | cloud
INSTANCE_ID=ai-portfolio-prod-01

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret

# === OpenClaw ===
OPENCLAW_WEBHOOK_SECRET=whsec_xxx

# === 微信 ===
WECHAT_APP_ID=wx...
WECHAT_APP_SECRET=...
WECHAT_WEBSITE_APP_ID=wx...
WECHAT_WEBSITE_APP_SECRET=...

# === AI ===
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === 数据源 ===
TUSHARE_TOKEN=...
LONGBRIDGE_APP_KEY=...
LONGBRIDGE_APP_SECRET=...
LONGBRIDGE_ACCESS_TOKEN=...
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_BATCH_SIZE=200

# === 缓存 ===
REDIS_URL=redis://localhost:6379/0
# 云端 Redis: rediss://default:xxx@xxx.upstash.io:6379

# === 支付 ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === 监控 ===
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=2.0.0

# === Data Service CORS ===
CORS_ALLOWED_ORIGINS=https://your-domain.vercel.app,https://your-custom-domain.com

# === gbrain Memory Storage ===
# MCP Adapter 路径（本地开发用相对路径，生产环境容器内用绝对路径）
GBRAIN_MCP_ADAPTER_PATH=./gbrain/src/mcp-adapter.ts
# MCP 运行时: bun | node
GBRAIN_MCP_RUNTIME=bun
# Embedding 模型
GBRAIN_EMBEDDING_MODEL=text-embedding-3-small
# 可独立配置 gbrain 数据库 URL（默认复用 SUPABASE_URL）
GBRAIN_DATABASE_URL=
